# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already git-ignored.

# --- Firebase (used only as a datastore for lead submissions) ---
# From your Firebase service account JSON:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the surrounding quotes and \n escapes exactly as they appear in the
# downloaded JSON's "private_key" field — but only in THIS file. Next.js's
# .env parser strips KEY="value" quoting automatically. A dashboard env var
# field (Vercel, etc.) is NOT a .env file — it takes the value verbatim, so
# paste only the raw key there with NO wrapping quotes, keeping the \n's:
#   -----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Telegram (new-lead alerts) ---
# From @BotFather (create a bot, copy the token) and getUpdates (chat id).
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Admin dashboard (Basic Auth on /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-launch

# --- Public site URL (used by next-sitemap and JSON-LD) ---
NEXT_PUBLIC_SITE_URL=https://example.com
